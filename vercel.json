{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd OpenJarvis/frontend && npm ci",
  "buildCommand": "cd OpenJarvis/frontend && npm run build",
  "outputDirectory": "OpenJarvis/frontend/dist",
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/v1/models", "destination": "/api/chat?route=models" },
    { "source": "/v1/info", "destination": "/api/chat?route=info" },
    { "source": "/v1/recommended-model", "destination": "/api/chat?route=recommended-model" },
    { "source": "/health", "destination": "/api/chat?route=health" },
    { "source": "/v1/chat/completions", "destination": "/api/chat?route=chat" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
