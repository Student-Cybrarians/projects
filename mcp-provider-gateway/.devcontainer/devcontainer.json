{
  "name": "MCP Provider Gateway",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -e '.[dev]'",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "MCP Provider Gateway",
      "onAutoForward": "notify"
    }
  }
}
